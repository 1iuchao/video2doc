# 统一换行符，避免 Windows 克隆后脚本满屏 ^M
* text=auto eol=lf

*.py   text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.csv  text eol=lf

# Windows 批处理必须是 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制，Git 不要尝试合并或转换
*.exe binary
*.dll binary
*.bin binary
*.zip binary
*.mp4 binary
*.wav binary
